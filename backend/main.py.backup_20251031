            instance_code,
            payload.completion_note,
        )

    # Completion is a local status update; cancellation not required but logged
    logger.info("Dispatch instance %s marked as completed by %s", instance_code, user_id)

    return {
        "success": True,
        "message": "派工已标记为完成",
